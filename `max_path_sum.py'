import sys
sys.setrecursionlimit(10**5)

class Solution:
    def maxPathSum(self, root):
        self.res = float('-inf')

        def dfs(node):
            if not node:
                return float('-inf')

            if not node.left and not node.right:
                return node.data

            ls = dfs(node.left)
            rs = dfs(node.right)

            if node.left and node.right:
                self.res = max(self.res, ls + rs + node.data)

            return max(ls, rs) + node.data

        dfs(root)

        if self.res == float('-inf'):
            return -1
        return self.res
